    <color name="app_background">#0E1311</color>
    <color name="app_surface">#161C19</color>
    <color name="app_surface_muted">#1E2622</color>
    <color name="app_outline">#2A332E</color>
    <color name="app_outline_soft">#222B27</color>

    <!-- Text -->
    <color name="text_primary">#ECF2EE</color>
    <color name="text_muted">#9AA8A1</color>
