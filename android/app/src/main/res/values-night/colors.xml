<resources>
    <!-- ============================================================
         QuickTap POS — night palette.
         Same two-colour language as day mode (one emerald accent on a
         neutral surface stack), inverted: ink surfaces, paper text.
         The accent stays runtime-overridable by the Super Admin.
         ============================================================ -->

    <!-- Brand (runtime-overridable) — lifted for contrast on dark ink -->
    <color name="brand_primary">#22C08A</color>
    <color name="brand_primary_dark">#8FE6C4</color>
    <color name="brand_primary_soft">#12291F</color>
    <color name="brand_secondary">#22C08A</color>
    <color name="brand_secondary_soft">#12291F</color>
    <color name="brand_accent">#22C08A</color>
    <color name="brand_accent_soft">#12291F</color>

