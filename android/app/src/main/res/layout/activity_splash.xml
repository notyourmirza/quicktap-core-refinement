<?xml version="1.0" encoding="utf-8"?>
<!--
  Remote-controlled splash screen. Every visual detail (title, tagline,
  colours, animation style and duration) comes from AppPrefs, which caches
  the Super Admin's /v1/theme + /v1/splash payload, so this renders
  correctly even fully offline.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <FrameLayout
            android:id="@+id/splashLogoWrap"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_avatar_circle">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:alpha="0"
            android:gravity="center"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.QuickTap.Display"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:alpha="0"
            android:indeterminateTint="@color/brand_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/splashCreditGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="34dp"
        android:alpha="0"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/splashCreditPrefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/splashCreditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
