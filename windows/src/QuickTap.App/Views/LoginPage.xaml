<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickTap.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Solid two-colour brand background, no gradients. -->
        <Rectangle Fill="{StaticResource BrandPrimaryBrush}" />

        <Border MaxWidth="420" Padding="34" CornerRadius="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Spacing="14">
                <TextBlock Text="QuickTap POS" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Sign in to your counter" Opacity="0.7" />

                <TextBox Header="Username" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox x:Name="PasswordInput" Header="Password" PasswordChanged="OnPasswordChanged" />

                <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="Crimson" TextWrapping="Wrap" />

                <Button Style="{StaticResource PrimaryActionStyle}"
                        Command="{x:Bind ViewModel.SignInCommand}"
                        IsEnabled="{x:Bind ViewModel.Busy, Mode=OneWay, Converter={StaticResource NotConverter}}"
                        Content="Sign in" />

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}" />

                <TextBlock Text="{x:Bind ViewModel.Credit}" Opacity="0.6" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
