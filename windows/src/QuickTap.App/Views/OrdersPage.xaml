<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickTap.App.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:QuickTap.Core.Entities">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Orders" Style="{StaticResource PageTitleStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <CalendarDatePicker Header="From" Date="{x:Bind ViewModel.From, Mode=TwoWay}" />
            <CalendarDatePicker Header="To" Date="{x:Bind ViewModel.To, Mode=TwoWay}" />
            <Button Content="Apply" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <ListView ItemsSource="{x:Bind ViewModel.Items}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Bill">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind InvoiceNo}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Opacity="0.7"
                                       Text="{x:Bind CreatedAt, Converter={StaticResource TimestampConverter}}" />
                            <TextBlock Grid.Column="2" Opacity="0.7" Text="{x:Bind OrderType}" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold"
                                       Text="{x:Bind Total, Converter={StaticResource MoneyConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
