<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickTap.App.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:QuickTap.Core.Entities">

    <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Customers" Style="{StaticResource PageTitleStyle}" />
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <ListView ItemsSource="{x:Bind ViewModel.Items}"
                          SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Customer">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Opacity="0.7" Text="{x:Bind Phone}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Balance, Converter={StaticResource MoneyConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
                <TextBlock Text="Customer details" Style="{StaticResource SectionTitleStyle}" />
                <TextBox Header="Name" Text="{x:Bind ViewModel.Selected.Name, Mode=TwoWay}" />
                <TextBox Header="Phone" Text="{x:Bind ViewModel.Selected.Phone, Mode=TwoWay}" />
                <TextBox Header="Email" Text="{x:Bind ViewModel.Selected.Email, Mode=TwoWay}" />
                <TextBox Header="Address" Text="{x:Bind ViewModel.Selected.Address, Mode=TwoWay}" />
                <NumberBox Header="Balance (udhaar)" Value="{x:Bind ViewModel.Selected.Balance, Mode=TwoWay}" />
                <Button Style="{StaticResource PrimaryActionStyle}" Content="Save"
                        Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="New customer" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.NewCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
