<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickTap.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <muxc:NavigationView x:Name="Nav"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="248"
                             SelectionChanged="OnSelectionChanged">

            <muxc:NavigationView.PaneHeader>
                <StackPanel Margin="14,10" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.ShopName}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}" FontSize="11" Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>
            </muxc:NavigationView.PaneHeader>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Point of sale" Tag="pos" Icon="Shop" />
                <muxc:NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" />
                <muxc:NavigationViewItem Content="Orders" Tag="orders" Icon="List" />
                <muxc:NavigationViewItem Content="Products" Tag="products" Icon="Tag" />
                <muxc:NavigationViewItem Content="Customers" Tag="customers" Icon="People" />
                <muxc:NavigationViewItem Content="Reports" Tag="reports" Icon="Calculator" />
                <muxc:NavigationViewItem Content="Marketplace" Tag="marketplace" Icon="Shop" />
                <muxc:NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <StackPanel Margin="14,8" Spacing="8">
                    <Button Content="Sync now" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.SyncNowCommand}" />
                    <Button Content="Sign out" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.SignOutCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.Credit}" FontSize="11" Opacity="0.6" />
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" Padding="24" />
        </muxc:NavigationView>
    </Grid>
</Page>
