<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickTap.App.Views.MarketplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QuickTap.App.ViewModels">

    <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Marketplace" Style="{StaticResource PageTitleStyle}" />

            <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MarketItem">
                        <Border Width="240" Margin="0,0,14,14" Padding="0" CornerRadius="{StaticResource CardCornerRadius}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <Image Height="140" Stretch="UniformToFill" Source="{x:Bind ImageUrl}" />
                                <StackPanel Padding="14" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Description}" Opacity="0.7" FontSize="12"
                                               TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{x:Bind Price, Converter={StaticResource MoneyConverter}}"
                                               FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
                <TextBlock Text="Buy now" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Selected.Description, Mode=OneWay}" Opacity="0.7"
                           TextWrapping="Wrap" />
                <TextBox Header="Your name" Text="{x:Bind ViewModel.ContactName, Mode=TwoWay}" />
                <TextBox Header="Phone" Text="{x:Bind ViewModel.ContactPhone, Mode=TwoWay}" />
                <NumberBox Header="Quantity" Minimum="1" Value="{x:Bind ViewModel.Quantity, Mode=TwoWay}" />
                <TextBox Header="Note" AcceptsReturn="True" Height="80"
                         Text="{x:Bind ViewModel.Note, Mode=TwoWay}" />
                <Button Style="{StaticResource PrimaryActionStyle}" Content="Send request"
                        Command="{x:Bind ViewModel.SubmitRequestCommand}" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
