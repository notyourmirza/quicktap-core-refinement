<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickTap.App.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Reports" Style="{StaticResource PageTitleStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <CalendarDatePicker Header="From" Date="{x:Bind ViewModel.From, Mode=TwoWay}" />
            <CalendarDatePicker Header="To" Date="{x:Bind ViewModel.To, Mode=TwoWay}" />
            <Button Content="Generate AI report" VerticalAlignment="Bottom"
                    Style="{StaticResource PrimaryActionStyle}"
                    Command="{x:Bind ViewModel.GenerateCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" VerticalAlignment="Bottom" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <ScrollViewer>
                <TextBlock Text="{x:Bind ViewModel.Report, Mode=OneWay}" TextWrapping="Wrap"
                           FontFamily="Consolas" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
