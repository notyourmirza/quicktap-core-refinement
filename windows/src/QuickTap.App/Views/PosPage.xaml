<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickTap.App.Views.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QuickTap.App.ViewModels"
    xmlns:entities="using:QuickTap.Core.Entities">

    <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Catalogue -->
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Point of sale" Style="{StaticResource PageTitleStyle}" />

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search or scan a barcode"
                         Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="All categories"
                          ItemsSource="{x:Bind ViewModel.Categories}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                          DisplayMemberPath="Name" />
            </Grid>

            <GridView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Products}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProductClick">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Product">
                        <Border Width="176" Height="128" Margin="0,0,12,12" Padding="14"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Bottom" Spacing="4">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{x:Bind Price, Converter={StaticResource MoneyConverter}}"
                                           Foreground="{StaticResource BrandPrimaryBrush}" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!-- Ticket -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Current ticket" Style="{StaticResource SectionTitleStyle}" />

                <StackPanel Grid.Row="1" Spacing="8">
                    <ComboBox Header="Order type" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.OrderTypes}"
                              SelectedItem="{x:Bind ViewModel.OrderType, Mode=TwoWay}" />
                    <TextBox Header="Table / reference" Text="{x:Bind ViewModel.TableNo, Mode=TwoWay}" />
                    <TextBox Header="Customer" Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay}" />
                </StackPanel>

                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Cart}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CartLine">
                            <Grid ColumnSpacing="8" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind LineTotal, Mode=OneWay, Converter={StaticResource MoneyConverter}}"
                                               Opacity="0.7" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Text="{x:Bind Qty, Mode=OneWay}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Content="-" Click="OnDecrement" Tag="{x:Bind}" />
                                    <Button Content="+" Click="OnIncrement" Tag="{x:Bind}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="3" Spacing="8">
                    <NumberBox Header="Discount" Value="{x:Bind ViewModel.Discount, Mode=TwoWay}" Minimum="0" />
                    <NumberBox Header="Cash received" Value="{x:Bind ViewModel.Paid, Mode=TwoWay}" Minimum="0" />

                    <Grid>
                        <TextBlock Text="Subtotal" Opacity="0.7" />
                        <TextBlock HorizontalAlignment="Right"
                                   Text="{x:Bind ViewModel.Subtotal, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Tax" Opacity="0.7" />
                        <TextBlock HorizontalAlignment="Right"
                                   Text="{x:Bind ViewModel.Tax, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Total" FontWeight="Bold" FontSize="18" />
                        <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="18"
                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                   Text="{x:Bind ViewModel.Total, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                    </Grid>

                    <Button Style="{StaticResource PrimaryActionStyle}" Content="Charge and print"
                            Command="{x:Bind ViewModel.CheckoutCommand}"
                            IsEnabled="{x:Bind ViewModel.CartHasItems, Mode=OneWay}" />
                    <Button Content="Clear ticket" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ClearCartCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.7" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
