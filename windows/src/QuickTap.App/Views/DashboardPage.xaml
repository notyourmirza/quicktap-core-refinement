<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickTap.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:QuickTap.Core.Entities">

    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />

            <GridView SelectionMode="None">
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Today's revenue" Opacity="0.7" />
                        <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}"
                                   Text="{x:Bind ViewModel.Revenue, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Orders" Opacity="0.7" />
                        <TextBlock FontSize="26" FontWeight="Bold" Text="{x:Bind ViewModel.Orders, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Average ticket" Opacity="0.7" />
                        <TextBlock FontSize="26" FontWeight="Bold"
                                   Text="{x:Bind ViewModel.AverageTicket, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Net after expenses" Opacity="0.7" />
                        <TextBlock FontSize="26" FontWeight="Bold"
                                   Text="{x:Bind ViewModel.Net, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                    </StackPanel>
                </Border>
            </GridView>

            <TextBlock Text="Recent bills" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <ListView ItemsSource="{x:Bind ViewModel.RecentBills}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Bill">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind InvoiceNo}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Opacity="0.7"
                                           Text="{x:Bind CreatedAt, Converter={StaticResource TimestampConverter}}" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold"
                                           Text="{x:Bind Total, Converter={StaticResource MoneyConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
